# Dependencias (se reinstalan con npm install)
node_modules/

# Secretos: el token del DENUE nunca debe salir del equipo
.env
.env.local

# Respaldos locales de la base (pesan 50 MB cada uno)
db-respaldo-*/

# Archivos temporales de la escritura atómica de segmentos
db/**/*.tmp
db/*.tmp

# Rutas del día: son datos vivos de cada instalación (los equipos las crean
# y modifican a diario). Si se versionaran, cada actualización del servidor
# las sobrescribiría con las del repositorio.
db/rutas.json

# Configuración local de herramientas
.claude/

# Salidas de ejecución
nohup.out
*.log
