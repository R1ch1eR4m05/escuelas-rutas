# Copia este archivo como .env y completa los valores.

# Puerto del servidor local (opcional, por defecto 3000)
PUERTO=3000

# Token gratuito de la API DENUE del INEGI.
# Se genera en: https://www.inegi.org.mx/app/api/denue/v1/tokenVerify.aspx
# Sin token, la app funciona pero el botón "Validar con INEGI" queda deshabilitado.
DENUE_TOKEN=
